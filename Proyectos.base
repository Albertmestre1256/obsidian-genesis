filters:
  and:
    - 'file.inFolder("00_CORE/cells")'
    - 'file.ext.lower() == "md"'
    - 'note.ejemplo != true'
    - '["celula", "célula"].contains(note.tipo.toString().trim().lower())'
    - 'file.name.lower() != "template_cell"'
properties:
  file.name:
    displayName: Ficha
  note.proyecto:
    displayName: Proyecto
  note.contexto:
    displayName: Contexto
  note.actualizado:
    displayName: Actualizado
views:
  - type: table
    name: Proyectos
    order:
      - file.name
      - note.proyecto
      - note.contexto
      - note.actualizado
